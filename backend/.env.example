# ==============================================================================
# GeoStrata Backend Configuration
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="GeoStrata National 3D ULPIN Engine"
API_V1_STR=/api/v1
API_V2_STR=/api/v2

# Security & Tokens
SECRET_KEY=geostrata-insecure-secret-key-change-for-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (AsyncPG driver for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://geostrata_admin:GeoStrataSecurePassword2026!@geostrata-db:5432/geostrata_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Vector Tile Buffer
REDIS_URL=redis://:RedisGeoStrataSecureKey2026!@geostrata-redis:6379/0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
